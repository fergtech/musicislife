# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Local Docker:
DATABASE_URL="postgresql://symposion:symposion@localhost:5432/symposion"
# Production (Neon): replace with your Neon connection string
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ──────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Local dev:
NEXTAUTH_URL="http://localhost:3000"
# Production: set to your Vercel domain, e.g.
# NEXTAUTH_URL="https://symposion.vercel.app"

# ──────────────────────────────────────────────
# MusicBrainz (optional — used in User-Agent header)
# ──────────────────────────────────────────────
# Fill in your app's contact email for MB rate-limit courtesy
MUSICBRAINZ_CONTACT="you@example.com"
